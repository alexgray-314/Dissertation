// Area where players put cards they want to play in tricks
define area centre;

// Tricks
define int winningPlayer;
define card winningCard;

// Scoring
define int score;
define int bestScore;
define int bestPlayer;

define function total_score(int p) {
    score = 0;
    for c in <p>[1,0:] {
        // Loop through all cards in player p's discard stack
        if c == #QS {
            // ...The Black Mariah
            score = score + 13;
        }
        if c.suit == hearts {
            if c.rank == ace {
                score = score + 5;
            }
            if c.rank == king {
                score = score + 4;
            }
            if c.rank == queen {
                score = score + 3;
            }
            if c.rank == jack {
                score = score + 2;
            }
            if c.rank <= 10 {
                score = score + 1;
            }
        }
    }
}

define function determine_winner() {
    bestScore = 1000000;
    bestPlayer = 0;
    for p in <*> {
        total_score(p);
        if score < bestScore {
            bestPlayer = p;
            bestScore = score;
        }
    }
    log "Player" bestPlayer "wins with score" bestScore;
}

// Card moved from turn player's hand to centre
on move <@>[0,0:] centre[0,0] {

	// block movement if it's not the players turn
	if <@> == <.> {

        if centre[0].length == 0 {
            // This is the first card to be placed down - VALID

            winningCard = source;
            winningPlayer = <@>;
        
        } else {
            // The trick suit has already been established

            if source.suit != winningCard.suit {
                // The card is not in-suit

                if winningCard.suit =? <@>[0, 0:].suit {
                    // The player has a card in-suit that they could have played - INVALID
                    cancel;
                }
                // Card can be "thrown away"

            } else {
                // The card is in-suit                

                if source.rank > winningCard.rank {
                    // Card is now the highest in the trick
                    winningCard = source;
                    winningPlayer = <@>;
                }

            }

        }

        // Execute move early
        move source dest;

        if centre[0].length == 4 {
            // this is the last card to be played

            <.> = <winningPlayer>;
            move centre[0,0:3] <winningPlayer>[1,0];
            log "Player" winningPlayer "wins the trick with" winningCard;
            if <.>[0].length == 0 {
                determine_winner();
            }
        } else {
            // It's the next players turn
            
            <.>++;
        }

    } else {
        cancel;
    }

}

// block all other card movements
on move ? ? {
	cancel;
}

winningPlayer = 0;
deal();

// Completely optional
$config {
    title "Black Maria",
    num_players 4
}

// Completely optional
$style {
    player {
        0 { // Assign label to stack 0 of all player areas
            label "Your Hand"
        }
    },
    centre {
        0 { // Assign label to stack 0 of area centre
            label "Discard Pile"
        }
    }
}