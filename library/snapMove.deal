define action snap;
define area centre;

on move <.>[0,0] centre[0,0] {
  // Can only move cards on your turn
  if <@> == <.> {
    <.>++;
  } else {
    cancel;
  }
}

on move ? ? {
  cancel;
}

on snap {
  if centre[0, 0].suit == centre[0, 1].suit {
    // The cards matched
    move centre[0,0:] <@>[0,0];
  } else {
    // The cards did not match.
    if <@> == <0> {
      // Give the cards to the player who did not snap
      move centre[0,0:] <1>[0,0];
    } else {
      move centre[0,0:] <0>[0,0];
    }
  }
}

deal();

$config {
  num_players 2,
  title "Snap"
}

$style {
    player {
        visibility hidden,
        0 {
            label "Your Hand",
            visibility private,
            display single,
            location hand
        }
    },
    a {
        visibility public,
        location north,
        0 {
            label "Discard Pile"
        }
    }
}
