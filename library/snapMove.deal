define action snap;
define area centre;

on move <.>[0,0] centre[0,0] {
  // Can only move cards on your turn
  if <@> == <.> {
    source.up();
    <.>++;
  } else {
    cancel;
  }
}

on move ? ? {
  cancel;
}

on snap {
  if centre[0, 0].rank == centre[0, 1].rank {
    // The cards matched
    <.> = <@>;
  } else {
    // The cards did not match.
    // Give the cards to the player who did not snap
    <.> = <@> + 1;
  }

  for crd in centre[0,0:] {
    crd.down();
  }
  move centre[0,0:] <.>[0,0];
}


for crd in deck[0,0:] {
  crd.down();
}

deal();

$config {
  num_players 2,
  title "Snap"
}

$style {
    player {
        visibility hidden,
        0 {
            label "Your Hand",
            visibility private,
            display single,
            location hand
        }
    },
    centre {
        visibility public,
        location north,
        0 {
            label "Discard Pile"
        }
    }
}
